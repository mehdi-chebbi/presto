# ── Copy this to .env and fill in your values ─────────────────────────────
# DO NOT commit the .env file to version control.

# Flask secret (auto-generated in dev, set a real string in production)
FLASK_SECRET_KEY=dev-secret-change-me

# CDSE OAuth credentials — ONLY needed if you use Client Credentials flow
# for the openEO backend. NOT required for the login form (Password Grant).
# CDSE_CLIENT_ID=your-client-id-here
# CDSE_CLIENT_SECRET=your-client-secret-here
